rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Visit logs ──────────────────────────────────────────────────────────
    // Anyone can write a visit (unauthenticated OK), but with size limits
    match /visits/{visitId} {
      allow create: if request.resource.data.keys().hasOnly([
                        'timestamp', 'userAgent', 'referrer',
                        'language', 'screenSize', 'timezone'
                      ])
                    && request.resource.data.userAgent is string
                    && request.resource.data.userAgent.size() < 512;
      allow read: if false; // Only accessible via Firebase Console / Admin SDK
      allow update, delete: if false;
    }

    // ── Voucher redemption state ─────────────────────────────────────────────
    // Single shared document — anyone can read/write (no auth needed)
    match /redemptions/{docId} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasAny([
                       'pass_01', 'pass_02', 'pass_03', 'pass_04_trophy_flip',
                       'lastUpdated'
                     ])
                   && request.resource.data.size() <= 10;
    }
  }
}
